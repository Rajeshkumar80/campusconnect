# Flask
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret

# MongoDB - local or Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=campusconnect

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME=86400

# Rate limiting
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_ENABLED=true

# Media uploads - defaults to backend/uploads when unset.
# Set an absolute path on Windows if the default does not resolve.
# UPLOAD_FOLDER=C:/Users/your-name/Desktop/campusconnect/backend/uploads
MAX_CONTENT_LENGTH=62914560

# Argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
